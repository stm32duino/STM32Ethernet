PROJECT_NAME = STM32Ethernet
PROJECT_BRIEF = Arduino Ethernet library for STM32 boards
OUTPUT_DIRECTORY = api-docs
INPUT = README.md src
FILE_PATTERNS = *.h *.c *.cpp *.md
RECURSIVE = YES
USE_MDFILE_AS_MAINPAGE = README.md
EXTRACT_ALL = YES
MACRO_EXPANSION = YES
EXPAND_ONLY_PREDEF = YES
PREDEFINED = __ALIGN_BEGIN= __ALIGN_END=
GENERATE_HTML = YES
HTML_OUTPUT = html
HTML_HEADER = docs/html-header.html
HTML_EXTRA_FILES = docs/version-selector.js
GENERATE_LATEX = NO
GENERATE_XML = NO
QUIET = YES
WARN_IF_UNDOCUMENTED = NO
WARN_AS_ERROR = NO
